{
  "$schema": "./_schema.json",
  "id": "dolly-out",
  "name": "Dolly Out",
  "category": "dolly",
  "description": "Camera pulls back to reveal the wider scene.",
  "prompt_template": "{scene} The camera dollies out smoothly, pulling back from the subject to reveal more of the surrounding environment and space behind the camera. {lens} {mood}",
  "negative": "camera shake, jitter, warping, morphing, flicker, scene cut, text, watermark",
  "duration": 5,
  "lora": {
    "name": "ltx-2-19b-lora-camera-control-dolly-out.safetensors",
    "strength": 1.0,
    "source": "Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Out"
  },
  "virtual_camera": {
    "keys": [
      {
        "t": 0
      },
      {
        "t": 1,
        "forward": -1.2
      }
    ],
    "ease": "inout"
  },
  "engines": {
    "workflow": {
      "workflow": "ltx2_i2v_camera",
      "params": {
        "lora_strength": 1.0,
        "cfg": 4.0
      }
    },
    "router": {
      "model": "minimax/minimax-h3",
      "alternates": [
        "byteplus/dreamina-seedance-2-5-260628",
        "xai/grok-imagine-video-1.5-lite"
      ],
      "body_overrides": {}
    }
  }
}
