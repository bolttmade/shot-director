{
  "$schema": "./_schema.json",
  "id": "jib-up",
  "name": "Jib Up",
  "category": "jib",
  "description": "Camera rises on a jib arm and tilts down.",
  "prompt_template": "{scene} The camera rises smoothly on a jib arm, lifting higher above the scene and tilting slightly down to reveal the layout of the landscape below. {lens} {mood}",
  "negative": "camera shake, jitter, warping, morphing, flicker, scene cut, text, watermark",
  "duration": 5,
  "lora": {
    "name": "ltx-2-19b-lora-camera-control-jib-up.safetensors",
    "strength": 1.0,
    "source": "Lightricks/LTX-2-19b-LoRA-Camera-Control-Jib-Up"
  },
  "virtual_camera": {
    "keys": [
      {
        "t": 0
      },
      {
        "t": 1,
        "up": 1.0,
        "pitch": -3.0,
        "forward": 0.2
      }
    ],
    "ease": "inout"
  },
  "engines": {
    "workflow": {
      "workflow": "ltx2_i2v_camera",
      "params": {
        "lora_strength": 1.0,
        "cfg": 4.0
      }
    },
    "router": {
      "model": "minimax/minimax-h3",
      "alternates": [
        "byteplus/dreamina-seedance-2-5-260628",
        "xai/grok-imagine-video-1.5-lite"
      ],
      "body_overrides": {}
    }
  }
}
