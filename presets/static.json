{
  "$schema": "./_schema.json",
  "id": "static",
  "name": "Static Lock-off",
  "category": "static",
  "description": "Locked tripod shot with life in the scene only.",
  "prompt_template": "{scene} A locked-off static camera on a tripod; only natural ambient motion in the scene, no camera movement. {lens} {mood}",
  "negative": "camera shake, jitter, warping, morphing, flicker, scene cut, text, watermark",
  "duration": 5,
  "lora": {
    "name": "ltx-2-19b-lora-camera-control-static.safetensors",
    "strength": 1.0,
    "source": "Lightricks/LTX-2-19b-LoRA-Camera-Control-Static"
  },
  "virtual_camera": {
    "keys": [
      {
        "t": 0
      },
      {
        "t": 1,
        "forward": 0.05
      }
    ],
    "ease": "linear"
  },
  "engines": {
    "workflow": {
      "workflow": "ltx2_i2v_camera",
      "params": {
        "lora_strength": 1.0,
        "cfg": 4.0
      }
    },
    "router": {
      "model": "minimax/minimax-h3",
      "alternates": [
        "byteplus/dreamina-seedance-2-5-260628",
        "xai/grok-imagine-video-1.5-lite"
      ],
      "body_overrides": {}
    }
  }
}
