{
  "$schema": "./_schema.json",
  "id": "jib-down",
  "name": "Jib Down",
  "category": "jib",
  "description": "Camera descends toward the ground.",
  "prompt_template": "{scene} The camera descends smoothly on a jib arm, sinking lower toward the foreground and tilting slightly up so the scene towers above. {lens} {mood}",
  "negative": "camera shake, jitter, warping, morphing, flicker, scene cut, text, watermark",
  "duration": 5,
  "lora": {
    "name": "ltx-2-19b-lora-camera-control-jib-down.safetensors",
    "strength": 1.0,
    "source": "Lightricks/LTX-2-19b-LoRA-Camera-Control-Jib-Down"
  },
  "virtual_camera": {
    "keys": [
      {
        "t": 0
      },
      {
        "t": 1,
        "up": -0.8,
        "pitch": 2.5,
        "forward": 0.2
      }
    ],
    "ease": "inout"
  },
  "engines": {
    "workflow": {
      "workflow": "ltx2_i2v_camera",
      "params": {
        "lora_strength": 1.0,
        "cfg": 4.0
      }
    },
    "router": {
      "model": "minimax/minimax-h3",
      "alternates": [
        "byteplus/dreamina-seedance-2-5-260628",
        "xai/grok-imagine-video-1.5-lite"
      ],
      "body_overrides": {}
    }
  }
}
