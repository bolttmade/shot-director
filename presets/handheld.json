{
  "$schema": "./_schema.json",
  "id": "handheld",
  "name": "Handheld",
  "category": "special",
  "description": "Documentary handheld, subtle sway.",
  "prompt_template": "{scene} Handheld documentary camera: subtle organic sway and breathing, the frame drifting slightly as if held by a person. {lens} {mood}",
  "negative": "camera shake, jitter, warping, morphing, flicker, scene cut, text, watermark",
  "duration": 5,
  "lora": null,
  "virtual_camera": {
    "keys": [
      {
        "t": 0
      },
      {
        "t": 1,
        "forward": 0.2
      }
    ],
    "ease": "linear",
    "shake": 1.0
  },
  "engines": {
    "workflow": {
      "workflow": "ltx2_i2v_camera",
      "params": {
        "lora_strength": 0.0,
        "cfg": 4.0
      }
    },
    "router": {
      "model": "minimax/minimax-h3",
      "alternates": [
        "byteplus/dreamina-seedance-2-5-260628",
        "xai/grok-imagine-video-1.5-lite"
      ],
      "body_overrides": {}
    }
  }
}
