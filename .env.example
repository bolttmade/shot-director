# Copy to .env (gitignored). Every line is optional: with nothing set, run `DEMO=1 python -m app.server`.

# --- mode ---------------------------------------------------------------
# DEMO=1 forces the Demo engine only: no keys, no network, simulated camera moves.
DEMO=
HOST=127.0.0.1
PORT=8000

# --- Comfy Router / Comfy Cloud (partner models, credits) ----------------
# Create a key in the Comfy dashboard. Never commit it.
COMFY_API_KEY=
# Hard per-run spend cap in credits. Runs whose estimate exceeds it are refused.
MAX_CREDITS_PER_RUN=50
# Set to 1 only if you accept running when Router cannot price a request.
ALLOW_UNKNOWN_COST=

# --- Open-weights engine (your own GPU) ----------------------------------
# Point at a local ComfyUI or comfy-api-proxy. Loopback / private addresses need no API key.
# COMFY_BASE_URL=http://127.0.0.1:8189   # uncomment ONLY for a local ComfyUI / comfy-api-proxy: setting it selects the open-weights engine
# --- Optional ------------------------------------------------------------
# REPO_URL: link shown in the UI header (defaults to https://github.com/bolttmade/shot-director).
# REPO_URL=
# OUTPUTS_DIR=./outputs
